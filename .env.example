# ============================================================
#  Contoh konfigurasi environment
#  Salin file ini menjadi `.env` lalu isi nilainya.
#    cp .env.example .env
# ============================================================

# ---------- Supabase ----------
# Diambil dari: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=isi-dengan-anon-public-key

# Opsional. Jika diisi, API akan memakai service role key (bypass RLS).
# Disarankan hanya dipakai di server / deployment, JANGAN pernah dikirim ke client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Server ----------
# Port untuk pengembangan lokal (Vercel mengabaikan ini).
PORT=3000
NODE_ENV=development

# ---------- Perilaku API ----------
# Tandai otomatis peminjaman yang melewati jatuh tempo sebagai "Terlambat"
# setiap kali endpoint GET /loans dipanggil. Nilai: true / false
AUTO_SYNC_OVERDUE=true
